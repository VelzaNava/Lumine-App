<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground.
  Android's adaptive-icon system requires the full layer to be 108x108 dp
  with a "safe zone" of only the inner 66x66 dp (= 60% inset). Anything
  outside the safe zone may be cropped by the launcher (circle / squircle
  / rounded-square shapes).

  This layer wraps the logo PNG and insets it on all four sides so the
  entire logo always sits inside the safe zone — no matter which mask the
  launcher uses.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/lumine_logo"
    android:inset="20%" />
