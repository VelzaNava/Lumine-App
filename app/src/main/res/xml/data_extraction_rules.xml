<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The saved login is encrypted with a key that never
     leaves the phone, so a restored or transferred copy could never be read. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lumine_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lumine_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
